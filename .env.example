# Clé API Resend — https://resend.com/api-keys
# Créer un compte Resend, générer une clé dans Settings > API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email destinataire des demandes de devis
# C'est l'adresse qui recevra chaque formulaire soumis
QUOTE_RECIPIENT_EMAIL=a.k.silva9@gmail.com

# Adresse expéditrice des emails de devis
# Par défaut : onboarding@resend.dev (adresse de test Resend — fonctionne sans domaine vérifié)
# En production : remplacer par une adresse sur un domaine vérifié dans Resend
#   ex : "DPM Marigot <devis@dpm-marigot.fr>"
# Voir : https://resend.com/domains
EMAIL_FROM=DPM Marigot <onboarding@resend.dev>

# Éditeur de page — expéditeur et destinataire du mail des retouches demandées.
# Facultatif : sans ces variables, le mail part de contact@asapworks.fr vers
# contact@asapworks.fr. L'expéditeur doit être sur un domaine vérifié dans Resend.
# EDITION_EMAIL_FROM=ASap Web <contact@asapworks.fr>
# EDITION_EMAIL_TO=contact@asapworks.fr

# ASap Devis — service central de génération d'estimations (opt-in)
# Vide = email simple historique. Renseignée = le lead est analysé + estimation PDF auto.
# ASAP_DEVIS_API_URL=https://asap-devis-api.vercel.app
